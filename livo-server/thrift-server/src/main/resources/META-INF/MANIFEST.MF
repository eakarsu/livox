Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Livo Server - Thrift Daemon
Bundle-SymbolicName: tr.com.eno.livo.server.thrift.daemon
Bundle-Version: 1.0.0
Bundle-Vendor: ENO
Bundle-RequiredExecutionEnvironment: JavaSE-1.6
Import-Package: org.apache.thrift;version="0.9.1",
 org.apache.thrift.protocol;version="0.9.1",
 org.apache.thrift.server;version="0.9.1",
 org.apache.thrift.transport;version="0.9.1",
 org.osgi.framework;version="1.7.0",
 org.slf4j;version="1.7.2"
Service-Component: OSGI-INF/*.xml

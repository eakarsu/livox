 tr.com.eno.livo.server.authc;version="1.0.0",
 tr.com.eno.livo.server.aspect;version="1.0.0",
 org.slf4j;version="1.7.2",
 org.aspectj.lang;version="1.8.5",
 org.aspectj.runtime.internal;version="1.8.5",
 org.aspectj.runtime.reflect;version="1.8.5",
 org.osgi.framework,
 javax.json
Service-Component: OSGI-INF/*.xml
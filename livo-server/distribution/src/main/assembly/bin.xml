<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
    <id>bin</id>
    <formats>
        <!--                <format>zip</format>-->
        <!--<format>tar.gz</format>-->
        <format>dir</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <moduleSets>
        <moduleSet>

            <!-- Enable access to all projects in the current multimodule build! -->
            <useAllReactorProjects>true</useAllReactorProjects>

            <!-- Now, select which projects to include in this module-set. -->
            <includes>
                <include>tr.com.eno.livo:analytics-spi</include>
                <include>tr.com.eno.livo:analytics-cassandra</include>
                <include>tr.com.eno.livo:application-spi</include>
                <include>tr.com.eno.livo:application-cassandra</include>
                <include>tr.com.eno.livo:aspects-shared</include>
                <include>tr.com.eno.livo:authentication-spi</include>
                <include>tr.com.eno.livo:authentication-dummy</include>
                <include>tr.com.eno.livo:authentication-cassandra</include>
                <include>tr.com.eno.livo:authentication-ldap</include>
                <include>tr.com.eno.livo:filetransfer-spi</include>
                <include>tr.com.eno.livo:filetransfer-disk</include>
                <include>tr.com.eno.livo:provision-spi</include>
                <include>tr.com.eno.livo:notification-spi</include>
                <include>tr.com.eno.livo:provision-properties</include>
                <include>tr.com.eno.livo:serviceobjects-spi</include>
                <include>tr.com.eno.livo:serviceobjects-calc</include>
                <include>tr.com.eno.livo:thrift-shared</include>
                <include>tr.com.eno.livo:thrift-proc-authc</include>
                <include>tr.com.eno.livo:thrift-proc-analytics</include>
                <include>tr.com.eno.livo:thrift-proc-filetransfer</include>
                <include>tr.com.eno.livo:thrift-proc-provision</include>
                <include>tr.com.eno.livo:thrift-proc-serviceobjects</include>
                <include>tr.com.eno.livo:thrift-proc-notification</include>
                <include>tr.com.eno.livo:thrift-server</include>
                <include>tr.com.eno.livo:users-spi</include>
                <include>tr.com.eno.livo:users-cassandra</include>
                <include>tr.com.eno.livo:cassandra-shared</include>
                <include>tr.com.eno.livo:serviceobjects-sapservice</include>
                <include>tr.com.eno.livo:serviceobjects-rest</include>
                <include>tr.com.eno.livo:serviceobjects-ws</include>
                <include>tr.com.eno.livo:serviceobjects-rest</include>
                <include>tr.com.eno.livo:notification-push-android</include>
                <include>tr.com.eno.livo:notification-push-combiner</include>
                <include>tr.com.eno.livo:notification-registration-cassandra</include>
                <include>tr.com.eno.livo:mail-spi</include>
                <include>tr.com.eno.livo:mail-sender</include>
                <include>tr.com.eno.livo:management-jmx</include>
                <include>tr.com.eno.livo:configurationadmin-proxy</include>
                <include>com.livomobile.server:metrics-shared</include>
            </includes>
            <binaries>
                <outputDirectory>/modules</outputDirectory>
                <outputFileNameMapping>${module.artifactId}.${module.extension}</outputFileNameMapping>
                <unpack>false</unpack>
            </binaries>
        </moduleSet>
    </moduleSets>
    <fileSets>
        <fileSet>
            <outputDirectory>/</outputDirectory>
            <directory>src/main/resources/</directory>
            <includes>
                <include>start.sh</include>
                <include>start.bat</include>
            </includes>
        </fileSet>
        <fileSet>
            <outputDirectory>/bin</outputDirectory>
            <directory>src/main/resources/</directory>
            <includes>
                <include>felix.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <outputDirectory>/lib</outputDirectory>
            <directory>src/main/resources/</directory>
            <includes>
                <include>activation.jar</include>
                <include>mail.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <outputDirectory>/conf</outputDirectory>
            <directory>src/main/resources/</directory>
            <includes>
                <include>config.properties</include>
            </includes>
            <filtered>true</filtered>
        </fileSet>
        <fileSet>
            <outputDirectory>/conf</outputDirectory>
            <directory>src/main/resources/</directory>
            <includes>
                <include>system.properties</include>
                <include>logback.xml</include>
            </includes>
        </fileSet>
        <fileSet>
            <outputDirectory>/modules</outputDirectory>
            <directory>src/main/resources/</directory>
            <includes>
                <include>libthrift-0.9.1.jar</include>
                <include>derby-shared.jar</include>
                <include>javax.json-1.0.4.jar</include>
                <include>mail.jar</include>
            </includes>
        </fileSet>
    </fileSets>
    <dependencySets>
        <dependencySet>
            <outputDirectory>/modules</outputDirectory>
            <includes>
                <include>org.apache.felix:org.apache.felix.log</include>
                <include>org.apache.felix:org.apache.felix.configadmin</include>
                <include>org.apache.felix:org.apache.felix.fileinstall</include>
                <include>org.apache.felix:org.apache.felix.metatype</include>
                <include>org.apache.felix:org.apache.felix.scr</include>
                <include>org.apache.felix:org.apache.felix.eventadmin</include>
                <include>org.apache.felix:org.apache.felix.shell</include>
                <include>org.apache.felix:org.apache.felix.shell.tui</include>
                <include>commons-io:commons-io</include>
                <include>commons-codec:commons-codec</include>
                <include>commons-collections:commons-collections</include>
                <include>commons-lang:commons-lang</include>
                <include>org.apache.commons:commons-lang3</include>
                <include>org.slf4j:slf4j-api</include>
                <include>ch.qos.logback:logback-classic</include>
                <include>ch.qos.logback:logback-core</include>
                <include>com.google.guava:guava</include>
                <include>org.apache.servicemix.bundles:org.apache.servicemix.bundles.aspectj</include>
                <include>javax.wsdl:com.springsource.javax.wsdl</include>
                <include>com.unboundid:unboundid-ldapsdk</include>
                <include>com.datastax.cassandra:cassandra-driver-core</include>
                <include>com.codahale.metrics:metrics-core</include>
                <include>io.netty:*</include>
                <include>org.codehaus.woodstox:*</include>
                <include>com.fasterxml.jackson.core:*</include>
            </includes>
        </dependencySet>
    </dependencySets>
</assembly>

Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Livo Server - Thrift Processor for Service Objects
Bundle-SymbolicName: tr.com.eno.livo.server.thrift.processor.serviceobjects
Bundle-Version: 1.0.0
Bundle-RequiredExecutionEnvironment: JavaSE-1.6
Import-Package: org.apache.thrift;version="0.9.1",
 org.osgi.framework;version="1.7.0",
 org.osgi.service.event,
 org.slf4j;version="1.7.2",
 tr.com.eno.livo.server.authc;version="1.0.0",
 tr.com.eno.livo.server.serviceobjects;version="1.0.0",
 tr.com.eno.livo.thrift.serviceobjects;version="1.0.0",
 tr.com.eno.livo.thrift.shared;version="1.0.0",
 javax.activation
Service-Component: OSGI-INF/*.xml

<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0"
               name="tr.com.eno.livo.server.application.cassandra.CassandraApplicationService"
               scr:xmlns="http://www.osgi.org/xmlns/scr/v1.1.0/scr" immediate="true" activate="start" deactivate="stop">
    <implementation
        class="tr.com.eno.livo.server.application.cassandra.CassandraApplicationService" />
    <property name="service.pid" type="String"
              value="tr.com.eno.livo.server.application.cassandra.CassandraApplicationService" />
    <property name="cassandra.host" type="String" value="localhost" />
    <property name="cassandra.port" type="Integer" value="9042" />
    <reference bind="registerService" cardinality="1..1"
               interface="org.osgi.service.event.EventAdmin" name="EventAdmin"
               policy="static" unbind="unregisterService" />
    <service>
        <provide interface="tr.com.eno.livo.server.application.ApplicationService" />
    </service>
</scr:component>



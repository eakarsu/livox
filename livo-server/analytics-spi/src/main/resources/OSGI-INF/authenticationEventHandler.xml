<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0"
	name="tr.com.eno.livo.server.analytics.event.AnalyticsAuthenticationEventHandler"
	singleton="true" scr:xmlns="http://www.osgi.org/xmlns/scr/v1.1.0/scr"
	immediate="true">
	<implementation
		class="tr.com.eno.livo.server.analytics.event.AnalyticsAuthenticationEventHandler" />
	<property name="service.pid" type="String"
		value="tr.com.eno.livo.server.analytics.event.AnalyticsAuthenticationEventHandler" />
	<property name="event.topics">
		tr/com/eno/livo/server/authentication/user/authenticated
		tr/com/eno/livo/server/authentication/company/authenticated
	</property>
	<reference bind="registerAnalyticsReceiverService"
		cardinality="1..n"
		interface="tr.com.eno.livo.server.analytics.AnalyticsReceiverService"
		name="AnalyticsReceiverService" policy="dynamic"
		unbind="unregisterAnalyticsReceiverService" />
	<service>
		<provide interface="org.osgi.service.event.EventHandler" />
	</service>
</scr:component>


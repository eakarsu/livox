<?xml version='1.0' encoding='utf-8'?>
<widget id="tr.com.eno.livo" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Livo</name>
    <description>
        Enterprise mobility platform.
    </description>
    <author email="info@livomobile.com" href="http://www.livomobile.com">
        Livo Team
    </author>
    <content src="index.html" />
    <access origin="*" />
	
	<!-- iOS specific configurations -->
	<platform name="ios">
		<!-- general -->
		<preference name="EnableViewportScale" value="true"/>
		<preference name="KeyboardDisplayRequiresUserAction" value="false"/>
		<!-- icons -->
        <!-- iOS 7.0+ -->
        <!-- iPhone / iPod Touch  -->
        <icon src="resources/icons/ios/Icon-60.png" width="60" height="60" />
        <icon src="resources/icons/ios/Icon-60@2x.png" width="120" height="120" />
        <!-- iPad -->
        <icon src="resources/icons/ios/Icon-76.png" width="76" height="76" />
        <icon src="resources/icons/ios/Icon-76@2x.png" width="152" height="152" />
        <!-- iOS 6.1 -->
        <!-- Spotlight Icon -->
        <icon src="resources/icons/ios/Icon-Small-40.png" width="40" height="40" />
        <icon src="resources/icons/ios/Icon-Small-40@2x.png" width="80" height="80" />
        <!-- iPhone / iPod Touch -->
        <icon src="resources/icons/ios/Icon.png" width="57" height="57" />
        <icon src="resources/icons/ios/Icon@2x.png" width="114" height="114" />
        <!-- iPad -->
        <icon src="resources/icons/ios/Icon-72.png" width="72" height="72" />
        <icon src="resources/icons/ios/Icon-72@2x.png" width="144" height="144" />
        <!-- iPhone Spotlight and Settings Icon -->
        <icon src="resources/icons/ios/Icon-Small.png" width="29" height="29" />
        <icon src="resources/icons/ios/Icon-Small@2x.png" width="58" height="58" />
        <!-- iPad Spotlight and Settings Icon -->
        <icon src="resources/icons/ios/Icon-Small-50.png" width="50" height="50" />
        <icon src="resources/icons/ios/Icon-Small-50@2x.png" width="100" height="100" />
        <!-- screens -->
        <splash src="resources/screens/ios/Default~iphone.png" width="320" height="480"/>
        <splash src="resources/screens/ios/Default@2x~iphone.png" width="640" height="960"/>
        <splash src="resources/screens/ios/Default-Portrait~ipad.png" width="768" height="1024"/>
        <splash src="resources/screens/ios/Default-Portrait@2x~ipad.png" width="1536" height="2048"/>
        <splash src="resources/screens/ios/Default-Landscape~ipad.png" width="1024" height="768"/>
        <splash src="resources/screens/ios/Default-Landscape@2x~ipad.png" width="2048" height="1536"/>
        <splash src="resources/screens/ios/Default-568h@2x~iphone.png" width="640" height="1136"/>
        <splash src="resources/screens/ios/Default-667h.png" width="750" height="1334"/>
        <splash src="resources/screens/ios/Default-736h.png" width="1242" height="2208"/>
        <splash src="resources/screens/ios/Default-Landscape-736h.png" width="2208" height="1242"/>
	</platform>
</widget>

# Required by the legacy Felix distribution launcher.
AEON_HOME=/srv/livo

# Optional file-transfer overrides. Keep the content store read-only to the
# server process after content has been published under its SHA-256 filename.
LIVO_FILE_STORAGE=/srv/livo/files
LIVO_FILE_TRANSFER_AUDIT=/srv/livo/audit/file-transfer.log
LIVO_FILE_TRANSFER_MAX_ACTIVE_SESSIONS=256
LIVO_FILE_TRANSFER_MAX_BUCKET_BYTES=8388608
LIVO_FILE_TRANSFER_SESSION_TTL_SECONDS=300

# Optional legacy website integration. Leave empty until the historical
# credential has been revoked and the retired Mailchimp API has been replaced.
LIVO_MAILCHIMP_API_KEY=

# This file contains no credentials. Inject secrets through the deployment
# platform; do not commit a populated .env file.
